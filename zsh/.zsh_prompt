# ~/.zsh_prompt — prompt configuration for zsh
# Format:
#   user@host ~/path (branch*)
#   %

setopt PROMPT_SUBST

__git_prompt() {
    local branch
    branch=$(git symbolic-ref --short HEAD 2>/dev/null) || \
    branch=$(git rev-parse --short HEAD 2>/dev/null) || return

    # git diff exits 1 when the worktree differs from HEAD and 128 when the
    # command itself fails, which is what happens before the first commit,
    # since HEAD resolves to nothing. Reading both as "dirty" put a * on every
    # freshly initialised repo, so compare against the index in that case.
    local dirty=""
    git diff --quiet --ignore-submodules HEAD 2>/dev/null
    case $? in
        1)   dirty="*" ;;
        128) git diff --cached --quiet 2>/dev/null || dirty="*" ;;
    esac

    if [[ -z "$dirty" && -n "$(git ls-files --others --exclude-standard 2>/dev/null)" ]]; then
        dirty="*"
    fi

    printf ' (%s%s)' "$branch" "$dirty"
}

# %F{color}…%f handles prompt-width counting in zsh
PROMPT='%B%F{141}%n@%m%f %F{75}%~%f%F{213}$(__git_prompt)%f%b
%# '

# Blank line between prompts (skipped on first prompt so shells open clean)
__zp_first=1
precmd() {
    [[ -n $__zp_first ]] && { __zp_first=; return; }
    print
}
