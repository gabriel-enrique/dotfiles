# ~/.shell_aliases — sourced by both bash and zsh

# Detect ls color flag (GNU vs BSD)
if ls --color=auto / >/dev/null 2>&1; then
    __ls_color='--color=auto'
else
    __ls_color='-G'
fi

alias ls="ls -h $__ls_color"
alias grep='grep --color=auto'

unset __ls_color

# Shorthands
alias cl='clear'
alias cls='clear'

# Re-source shell config without opening a new terminal.
# Replace the running shell, not $SHELL -- that names the login shell from
# /etc/passwd, so `reload` in zsh under a bash login would land you in bash.
# Non-login on purpose: the environment survives exec, so re-running the
# profile would only re-prepend PATH entries that are already there.
if [ -n "$ZSH_VERSION" ]; then
    alias reload='exec zsh'
else
    alias reload='exec bash'
fi

# Make a directory and cd into it
mkcd() { mkdir -p "$1" && cd "$1"; }

# Show processes listening on TCP ports (GNU ss on Linux, lsof on BSD/macOS)
if command -v ss >/dev/null 2>&1; then
    alias ports='ss -tulpn'
else
    alias ports='lsof -iTCP -sTCP:LISTEN -P'
fi

# Search shell history: h <pattern>
# zsh's `history` shows only the last 16 entries; `history 1` starts at event 1.
# bash reads the same argument as a count, where `history 1` means the last line.
if [ -n "$ZSH_VERSION" ]; then
    alias h='history 1 | grep'
else
    alias h='history | grep'
fi

# Navigation
alias ..='cd ..'
alias ....='cd ../..'
alias ......='cd ../../..'

# Editor
if command -v nvim >/dev/null 2>&1; then
    alias vim='nvim'
    export EDITOR=nvim
    export VISUAL=nvim
fi
