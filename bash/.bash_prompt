# ~/.bash_prompt — prompt configuration for bash
# Format:
#   user@host ~/path (branch*)
#   $

__git_prompt() {
    local branch
    branch=$(git symbolic-ref --short HEAD 2>/dev/null) || \
    branch=$(git rev-parse --short HEAD 2>/dev/null) || return

    # One status call reports staged, unstaged and untracked changes in a
    # single pass, where diff plus ls-files walked the worktree twice. It also
    # needs no special case before the first commit, when HEAD does not resolve
    # and `diff HEAD` fails outright.
    #
    # --no-optional-locks is required, not decorative: plain `git status`
    # refreshes and rewrites .git/index, which diff and ls-files never did.
    # Without it every prompt redraw would take the index lock and could
    # contend with a git command running in another pane.
    # --untracked-files=normal pins that behaviour too: status honours
    # status.showUntrackedFiles, and a repo or global setting of "no" would
    # otherwise stop untracked files marking the prompt dirty. ls-files, which
    # this replaced, ignored that setting.
    local dirty=""
    if [ -n "$(git --no-optional-locks status --porcelain --untracked-files=normal --ignore-submodules 2>/dev/null)" ]; then
        dirty="*"
    fi

    printf ' (%s%s)' "$branch" "$dirty"
}

# Colors wrapped in \[ \] so bash counts prompt width correctly
__c_user='\[\e[1;38;5;40m\]'    # bold green
__c_path='\[\e[1;38;5;208m\]'   # bold orange
__c_git='\[\e[1;38;5;220m\]'    # bold gold
__c_reset='\[\e[0m\]'

PS1="${__c_user}\u@\h${__c_reset} ${__c_path}\w${__c_reset}${__c_git}\$(__git_prompt)${__c_reset}\n\$ "

# Blank line between prompts (skipped on first prompt so shells open clean)
__bp_first=1
__bp_blank() {
    if [ -n "$__bp_first" ]; then
        __bp_first=
    else
        printf '\n'
    fi
}
PROMPT_COMMAND="__bp_blank${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
